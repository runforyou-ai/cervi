# 服务端与 HTTPS
WAILS_SERVER_HOST=127.0.0.1
WAILS_SERVER_PORT=8080
# 直接管理证书使用 auto，外层代理或 CDN 使用 external，关闭 HTTPS 使用 off。
TLS_MODE=off
TLS_DATA_DIR=data/tls
TLS_ACME_EMAIL=

# 桌面开发与 MCP
WAILS_VITE_PORT=9245
WAILS_MCP_HOST=127.0.0.1
WAILS_MCP_PORT=9099
WAILS_MCP_TIMEOUT=30000

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=cervi
POSTGRES_PASSWORD=cervi_local_dev
POSTGRES_DB=cervi_main
POSTGRES_SSLMODE=disable

# NATS
# 服务地址和任务命名空间。
NATS_URL=nats://127.0.0.1:4222
NATS_NAMESPACE=main

# 文件与本地数据
# 服务端文件目录和桌面端 SQLite 数据目录。
FILE_STORAGE_PATH=data/files
DESKTOP_DATA_DIR=data/desktop
