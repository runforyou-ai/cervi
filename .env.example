# 每个 Git worktree 复制一份为 .env，并分配独立端口、数据库和公网地址。
CERVI_ENV=development
CERVI_WORKSPACE=main

# 直接管理证书使用 auto，外层代理或 CDN 使用 external，关闭 HTTPS 使用 off。
CERVI_HTTPS_MODE=off
# auto 模式监听 80/443，证书数据目录必须持久化。
CERVI_TLS_DATA_DIR=data/tls
CERVI_ACME_EMAIL=

WAILS_SERVER_HOST=127.0.0.1
WAILS_SERVER_PORT=8080
WAILS_VITE_PORT=9245

WAILS_MCP=1
WAILS_MCP_HOST=127.0.0.1
WAILS_MCP_PORT=9099
WAILS_MCP_TIMEOUT=30000

CERVI_INFRA_COMPOSE_PROJECT=cervi
CERVI_POSTGRES_USER=cervi
CERVI_DATABASE_NAME=cervi_main
DATABASE_URL=postgres://cervi:cervi_local_dev@127.0.0.1:5432/cervi_main?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=8
POSTGRES_MAX_IDLE_CONNS=2
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_STARTUP_TIMEOUT=1m

FILE_STORAGE_PATH=data/files
CERVI_DESKTOP_DATA_DIR=data/desktop
CERVI_PUBLIC_URL=https://cervi-main-dev.runforyou.app
