FROM golang:1.27-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 go build -tags server,production -trimpath -buildvcs=false -ldflags="-s -w" -o server .

FROM gcr.io/distroless/static-debian12

COPY --from=builder /app/server /server

EXPOSE 80 443 8080

ENV WAILS_SERVER_HOST=0.0.0.0
ENV FILE_STORAGE_PATH=/data/files
ENV TLS_DATA_DIR=/data/tls

VOLUME ["/data/files", "/data/tls"]

ENTRYPOINT ["/server"]
