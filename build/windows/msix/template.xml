<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="cervi"
        Arguments=""
        InstallLocation="C:\Program Files\runforyou\Cervi">
    </Installer>
    <PackageInformation
        PackageName="app.runforyou.cervi"
        PackageDisplayName="Cervi"
        PublisherName="CN=runforyou"
        PublisherDisplayName="runforyou"
        Version="0.1.0.0"
        PackageDescription="Cervi is an open-source AI customer support teammate platform.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.runforyou.cervi"
                Description="Cervi is an open-source AI customer support teammate platform."
                DisplayName="Cervi"
                ExecutableName="cervi"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Cervi</DisplayName>
            <PublisherDisplayName>runforyou</PublisherDisplayName>
            <Description>Cervi is an open-source AI customer support teammate platform.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="cervi.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
